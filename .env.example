# ===== Damascus Flowers — Production environment =====
# PostgreSQL connection (inside docker-compose use the service name "db")
DATABASE_URL=postgresql://damascus:CHANGE_DB_PASSWORD@db:5432/damascus_flowers

# Admin login (fallback only — real password is stored hashed in DB and changed from /admin)
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# 64+ random hex chars: openssl rand -hex 32
ADMIN_SESSION_SECRET=CHANGE_ME_RANDOM_64_HEX

# Public site URL (used for sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://damascusflowers.com

# Optional — Meta WhatsApp Cloud API automatic notifications (leave empty if not used)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=hello_world

# Used by docker-compose for the Postgres container
POSTGRES_USER=damascus
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
POSTGRES_DB=damascus_flowers

# ===== Free hosting (Vercel + Neon + Cloudinary) =====
# Neon: copy the "Pooled connection" string, e.g. postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Cloudinary (for product photo uploads from /admin on Vercel): Dashboard → API Keys → "API environment variable"
CLOUDINARY_URL=
# One-time secret to initialize the database from the browser: https://your-site/api/setup?key=THIS_VALUE
SETUP_KEY=
